# Copy this file to .env.local; never commit actual keys.
# Never use NEXT_PUBLIC_* / VITE_* for provider keys or tracing secrets.
# Provider configuration is server-only and works while signed out of ChatGPT.
# Direct execution: openai (default), anthropic (alias: claude), or local.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional hosted ChatGPT identity sign-in. Leave blank until OpenAI approval.
# This does NOT enable ChatGPT plan usage for model requests.
CHATGPT_CLIENT_ID=
# Exact registered HTTPS callback: https://your-host/api/auth/chatgpt/callback
CHATGPT_REDIRECT_URI=
# Provisioned method: none or client_secret_basic (do not guess).
CHATGPT_TOKEN_AUTH_METHOD=
CHATGPT_CLIENT_SECRET=
# Absolute private persistent directory outside public/source directories.
# Must be shared by all workers, with atomic rename support (see auth docs).
CHATGPT_AUTH_STORAGE_DIR=

# Optional legacy LangSmith tracing. Keep disabled for the Grafana-only demo.
# Remote traces may contain workflow configuration and conversation.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=visual-dxp-workflow-editor
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Claude server defaults (no model fallback; use an account-accessible model ID).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local server defaults (OpenAI-compatible, tool-capable model).
# Only localhost, 127.0.0.1, and [::1] destinations are accepted.
# Localhost is the backend machine/container, not the visitor’s computer.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Optional remote Agent Server / LangSmith deployment mode:
# When set, remote execution takes precedence over AI_PROVIDER in this proxy.
# Configure AI_PROVIDER and its credentials independently in the remote graph.
LANGGRAPH_API_URL=
LANGGRAPH_ASSISTANT_ID=workflow_editor
# Use LANGSMITH_API_KEY above for deployments requiring X-Api-Key.
# OPENAI_API_KEY belongs in the remote graph's environment in this mode.

# Per-IP chat quota: name of a header your trusted proxy OVERWRITES with one client IP.
# Defaults to Cloudflare's visitor IP header. Restrict origin access to Cloudflare.
# Lists of IPs are rejected; X-Forwarded-For is not used as a fallback.
# Empty/unavailable/invalid IPs share a fallback quota; arbitrary headers are not trusted.
AI_RATE_LIMIT_IP_HEADER=cf-connecting-ip

# OpenTelemetry: Node server only. No endpoint => console exporters (no credentials).
# See docs/observability.md
OTEL_SERVICE_NAME=visual-dxp
# Standard comma-separated resource attributes (no secrets or per-run identifiers).
OTEL_RESOURCE_ATTRIBUTES=service.namespace=my-application-group,deployment.environment=development
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_SDK_DISABLED=false
# Parent-based trace-id ratio sampling; 1 captures every locally rooted workflow.
OTEL_TRACES_SAMPLER_ARG=1
# Full conversation capture is opt-in, independently of trace sampling.
CAPTURE_LLM_CONTENT=false
# Maximum redacted UTF-8 bytes PER content record (256 bytes to 1 MiB).
LLM_CONTENT_MAX_BYTES=262144
# Server-only OTLP/HTTP JSON. Get exact endpoint/auth from Grafana's OTLP tile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Optional full per-signal endpoints, including /v1/{traces,logs,metrics}:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_{TRACES,LOGS,METRICS}_HEADERS also supported by the SDKs.

