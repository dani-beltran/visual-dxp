# Next.js server only. Copy this file to .env.local; never commit actual keys.
# Never use NEXT_PUBLIC_* / VITE_* for provider or tracing configuration.
# Local LangChain model mode (leave LANGGRAPH_API_URL empty):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional tracing. Traces may contain workflow configuration and conversation.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=dlb-dxp-workflow-editor
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Optional remote Agent Server / LangSmith deployment mode:
# When set, the Next.js API uses the deployment instead of the local model.
LANGGRAPH_API_URL=
LANGGRAPH_ASSISTANT_ID=workflow_editor
# Use LANGSMITH_API_KEY above for deployments requiring X-Api-Key.
# OPENAI_API_KEY belongs in the remote graph's environment in this mode.

# Application authentication is separate from OpenAI credentials.
# Prefer a session/workflow authorization adapter passed to handleChat.
# For a trusted single-tenant gateway, set this secret on the server and inject
# Authorization: Bearer <token> only after authenticating/authorizing the user.
# Never expose a gateway token in public environment variables or workflow data.
AI_APPLICATION_TOKEN=
