{
  "name": "@forma/dxp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Embeddable React 19 digital experience workflow editor",
  "files": [
    "dist"
  ],
  "main": "./dist/forma-dxp.umd.cjs",
  "module": "./dist/forma-dxp.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/forma-dxp.js",
      "require": "./dist/forma-dxp.umd.cjs"
    },
    "./styles.css": "./dist/forma-dxp.css",
    "./picker-bridge": "./dist/picker-bridge.js"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --config vite.lib.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.11"
  }
}
