{
  "name": "visual-dxp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Embeddable React 19 digital experience workflow editor",
  "files": [
    "dist"
  ],
  "main": "./dist/visual-dxp.umd.cjs",
  "module": "./dist/visual-dxp.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/visual-dxp.css",
  "sideEffects": [
    "**/*.css",
    "./dist/bridge.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/visual-dxp.js",
      "require": "./dist/visual-dxp.umd.cjs"
    },
    "./styles.css": "./dist/visual-dxp.css",
    "./bridge": "./dist/bridge.js"
  },
  "scripts": {
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "predev": "npm run build:bridge",
    "prebuild": "npm run build:bridge",
    "prebuild:lib": "npm run build:bridge",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "test": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "start": "next start --hostname 0.0.0.0",
    "build:lib": "vite build --config vite.lib.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke.mjs",
    "pretest": "npm run build:bridge"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/openai": "4.0.78",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.16",
    "@xyflow/react": "^12.10.0",
    "ai": "7.0.118",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
